# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JAGAT Colony & Infrastructure Variable Names (Phase 1)
REDIS_URL="redis://localhost:6379"
QDRANT_HOST="http://localhost:6333"
QDRANT_COLLECTION="jagat_indonesia_knowledge"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_REMOTE_ENABLED="false"
INFERENCE_MODEL="llama3:latest"
EMBEDDING_MODEL="nomic-embed-text"

# Outbound & Inbound Email Variable Names (Never store secrets in repo)
EMAIL_ENABLED="false"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_USER="YOUR_EMAIL_USER"
EMAIL_PASS="YOUR_GOOGLE_APP_PASSWORD"
CALENDLY_LINK="https://calendly.com/jagat-ai/15min"

# Telegram Bot Variable Names
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_FOUNDER_CHAT_ID="YOUR_TELEGRAM_FOUNDER_CHAT_ID"

# Phase 1 Autonomy, Feature Flags & Budget Guardrails
JAGAT_OUTBOUND_MODE="APPROVAL"
JAGAT_GLOBAL_PAUSE="false"
JAGAT_BUDGET_HARD_CAP_IDR="500000"
JAGAT_DAILY_ALERT_IDR="35000"
FF_OUTREACH_POLICY_ENGINE="true"
FF_IDEMPOTENCY_GUARD="true"
FF_LEAD_STATE_MACHINE="true"
FF_INBOUND_SAFETY_GUARD="true"
FF_MODEL_COST_ROUTER="true"
FF_RAG_HEALTH_GUARD="true"
